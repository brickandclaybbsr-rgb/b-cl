# ─────────────────────────────────────────────────────────────
#  Brick & Clay Ops — Environment Variables
#  Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────────────────────

# Supabase ─────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Never expose to the browser. Used by cron + admin actions.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# WhatsApp — Meta Cloud API ────────────────────────────────────
# https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Default owner number reports go to (with country code, no +). e.g. 919876543210
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX
# Optional: a pre-approved template name for sending outside the 24h window.
# Leave blank to send a plain text message (only works inside 24h session window).
WHATSAPP_TEMPLATE_NAME=

# App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ops.brickandclay.in
# Random secret used to authorize the Vercel cron call. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=your_random_secret_for_cron_auth
